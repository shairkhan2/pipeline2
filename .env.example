# Copy to .env. This file is runtime configuration, never image build input.
# Production requires HTTPS at the public reverse proxy.
PLAYER_COOKIE_SECURE=true
PLAYER_BIND=127.0.0.1
PLAYER_PORT=8080

# Provider credentials and optional adapters can be added here.
# Set MANHWA_MIT_DIR and MANHWA_MIT_PY only after mounting/installing the cleaner.
# Keep container storage paths at the image defaults unless mounts change too.
