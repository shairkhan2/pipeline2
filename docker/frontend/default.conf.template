server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # The backend enforces its configured upload limit while streaming to disk.
    client_max_body_size 0;
    client_body_timeout 600s;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location = /_session_check {
        internal;
        proxy_pass ${BACKEND_URL}/api/session;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
    }

    location = /login {
        proxy_pass ${BACKEND_URL};
    }

    # First-run bootstrap: the wizard and its API must be reachable before an
    # htpasswd file exists, so both bypass auth_request.
    location = /setup {
        try_files /setup.html =404;
    }

    # Static bundle assets must load before an admin exists, so /setup.html can
    # boot: they bypass auth_request. HTML entry points stay protected below.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /icons/ {
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
    }

    location = /studio {
        auth_request /_session_check;
        error_page 401 = @login;
        add_header Cache-Control "no-cache" always;
        try_files /studio.html =404;
    }

    location ~ ^/setup(\.html|\.css|\.js)?$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri /setup.html =404;
    }

    location ~ ^/api/(setup|studio)(/|$) {
        proxy_pass ${BACKEND_URL};
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location ~ ^/(api|media|poster|thumbs)/ {
        proxy_pass ${BACKEND_URL};
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location / {
        auth_request /_session_check;
        error_page 401 = @login;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }

    location @login {
        return 303 /login;
    }
}
